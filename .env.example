# ==============================================================
# BRANDGUARD AI - ENVIRONMENT CONFIGURATION
# CodeNova India 2026 - Round 2
# ==============================================================

# Server Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=brandguard-hackathon-secret-key-2026

# Database Configuration
# BrandGuard AI automatically connects to real MongoDB.
# If MongoDB is unavailable or credentials are omitted,
# the app seamlessly activates its built-in in-memory fallback store.
MONGODB_URI=mongodb://127.0.0.1:27017/brandguard_ai

# Python AI Service Integration
AI_SERVICE_URL=http://127.0.0.1:8000
AI_PORT=8000

# LLM Providers (Optional for demo; if omitted, the local rule-based deterministic RAG engine is used)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
